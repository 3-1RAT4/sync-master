generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model playlists {
  external_id   String
  title         String
  folder_path   String?
  leaf_name     String?
  actions       action_name[]
  first_seen_at DateTime      @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime      @default(now()) @db.Timestamptz(6)
  id            BigInt        @id @default(autoincrement())
  source        String        @default("youtube")
  description   String?
  thumbnail_url String?
  item_count    Int?
  published_at  DateTime?     @db.Timestamptz(6)
  sources       sources       @relation(fields: [source], references: [id], onDelete: NoAction, onUpdate: NoAction)
  videos        videos[]

  @@unique([source, external_id])
}

model sources {
  id           String      @id
  display_name String
  playlists    playlists[]
  videos       videos[]
}

model spotify_playlists {
  name                String   @id
  spotify_playlist_id String   @unique
  created_at          DateTime @default(now()) @db.Timestamptz(6)
}

model spotify_syncs {
  id                  BigInt               @id @default(autoincrement())
  spotify_track_id    String
  spotify_track_uri   String
  spotify_playlist_id String
  matched_via         spotify_match_source
  synced_at           DateTime             @default(now()) @db.Timestamptz(6)
  video_id            BigInt               @unique
  videos              videos               @relation(fields: [video_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model summaries {
  id           BigInt   @id @default(autoincrement())
  content      String
  instructions String
  llm_provider String
  llm_model    String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  video_id     BigInt   @unique
  videos       videos   @relation(fields: [video_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sync_state {
  id   Int  @id @default(1) @db.SmallInt
  data Json @default("{\"videos\": {}}")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transcript_segments {
  id            BigInt      @id @default(autoincrement())
  transcript_id BigInt
  start_seconds Decimal     @db.Decimal(10, 3)
  end_seconds   Decimal     @db.Decimal(10, 3)
  speaker       String
  text          String?
  transcripts   transcripts @relation(fields: [transcript_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transcript_id], map: "idx_transcript_segments_transcript_id")
}

model transcripts {
  id                  BigInt                @id @default(autoincrement())
  source              transcript_source
  text                String
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  video_id            BigInt                @unique
  transcript_segments transcript_segments[]
  videos              videos                @relation(fields: [video_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model video_files {
  id           BigInt   @id @default(autoincrement())
  filename     String
  content_type String?
  size_bytes   BigInt
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  content_oid  Int      @db.Oid
  video_id     BigInt   @unique
  videos       videos   @relation(fields: [video_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model videos {
  external_id   String
  id            BigInt         @id @default(autoincrement())
  source        String         @default("youtube")
  playlist_id   BigInt?
  title         String
  description   String?
  thumbnail_url String?
  published_at  DateTime?      @db.Timestamptz(6)
  first_seen_at DateTime       @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime       @default(now()) @db.Timestamptz(6)
  spotify_syncs spotify_syncs?
  summaries     summaries?
  transcripts   transcripts?
  video_files   video_files?
  playlists     playlists?     @relation(fields: [playlist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sources       sources        @relation(fields: [source], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([source, external_id])
}

enum action_name {
  download
  transcript
  summarize
  spotify_sync
}

enum spotify_match_source {
  override
  search
}

enum transcript_source {
  captions
  whisper
  unknown
}
